     "text": [
      "Enter the array elements separated with space:  2 3 4 5 5 \n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Even Numbers are: [2, 4]\n"
     ]
    }
   ],
   "source": [
    "arr = list(map(int, input(\"Enter the array elements separated with space: \").split()))\n",
    "even = []\n",
    "for num in arr:\n",
    "    if num % 2 == 0:\n",
    "        even.append(num)\n",
    "\n",
    "print(\"Even Numbers are:\", even) "
   ]
